# Public/non-secret configuration
ALLOWED_ORIGINS=https://your-company.feishu.cn
PUBLIC_BASE_URL=https://your-service.up.railway.app
MAX_VIDEO_SIZE_MB=30
MAX_AUDIO_SOURCE_SIZE_MB=500
DOWNLOAD_CONCURRENCY=2
TICKET_TTL_SECONDS=900
PREPARED_VIDEO_DIR=/tmp/feishu-video-extractor-cache
ALLOWED_VIDEO_DOMAINS=douyin.com,iesdouyin.com,tiktok.com,xiaohongshu.com,xhslink.com,bilibili.com,b23.tv,kuaishou.com

# Production authentication
REQUIRE_BASE_SIGNATURE=true
# Leave empty only before the first official release. Multiple IDs use commas.
EXPECTED_PACK_ID=

# Generate new values in the target environment. Never commit real values.
TICKET_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIES_CONTENT=REPLACE_IN_RAILWAY_SECRET_UI_OR_CLI
# 云端容器通常不存在可读取的桌面浏览器，保持为空。
COOKIES_FROM_BROWSER=
COOKIES_BROWSER_PROFILE=

# Optional Windows local worker
WORKER_ENABLED=false
WORKER_TOKEN=REPLACE_ONLY_IF_WORKER_IS_ENABLED
WORKER_DOMAINS=douyin.com,iesdouyin.com
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_CLAIM_WAIT_SECONDS=20
WORKER_HEARTBEAT_TTL_SECONDS=60
