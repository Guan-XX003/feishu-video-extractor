ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
MAX_VIDEO_SIZE_MB=30
MAX_AUDIO_SOURCE_SIZE_MB=500
DOWNLOAD_CONCURRENCY=2
ALLOWED_VIDEO_DOMAINS=douyin.com,iesdouyin.com,tiktok.com,xiaohongshu.com,xhslink.com,bilibili.com,b23.tv,kuaishou.com
PUBLIC_BASE_URL=http://localhost:8000
TICKET_SECRET=change-me-in-production
TICKET_TTL_SECONDS=600
PREPARED_VIDEO_DIR=/tmp/feishu-video-extractor-cache
# Netscape cookies.txt，只保留 douyin.com / iesdouyin.com 域名。
COOKIES_FILE=
# 云部署时可将 cookies.txt 全文作为加密环境变量注入，优先级高于 COOKIES_FILE。
COOKIES_CONTENT=
REQUIRE_BASE_SIGNATURE=false
# 首次提交时可留空；取得正式字段捷径 ID 后填写以进一步限制调用方。
EXPECTED_PACK_ID=
# 可选：让 Windows 本地助手处理抖音链接。
WORKER_ENABLED=false
WORKER_TOKEN=
WORKER_DOMAINS=douyin.com,iesdouyin.com
WORKER_JOB_TIMEOUT_SECONDS=300
WORKER_CLAIM_WAIT_SECONDS=20
WORKER_HEARTBEAT_TTL_SECONDS=60
